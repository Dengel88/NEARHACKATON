# --- Modes -------------------------------------------------------------
# mock  = runs fully offline, no keys needed (default; what CI and judges get)
# live  = real NEAR Intents 1Click API / real LLM
ONECLICK_MODE=mock
LLM_PROVIDER=mock            # mock | gemini | openai  (openai = any OpenAI-compatible API, e.g. NEAR AI Cloud)

# --- LLM (OpenAI-compatible). Default target: NEAR AI Cloud private inference
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_API_KEY=
LLM_MODEL=zai-org/GLM-5.1-FP8

# --- Gemini (LLM_PROVIDER=gemini) ----------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- NEAR Intents 1Click ------------------------------------------------
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=            # optional; without it 1Click adds a 0.25% fee
# Where the merchant gets paid: a NEAR account, settlement asset = USDC on NEAR
MERCHANT_NEAR_ACCOUNT=merchant.near
USDC_ASSET_ID=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# --- Manager handoff (optional) -----------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage --------------------------------------------------------------
DB_PATH=data/app.db
MERCHANT_DASHBOARD_TOKEN=    # if set, /merchant API requires ?token=...
